  "components": {
    "schemas": {
      "Allergen": {
        "enum": [
          "Gluten",
          "Crustaceans",
          "Eggs",
          "Fish",
          "Peanuts",
          "Soy",
          "Milk",
          "TreeNuts",
          "Celery",
          "Mustard",
          "Sesame",
          "Sulphites",
          "Lupin",
          "Molluscs"
        ]
      },
      "AnimalProduct": {
        "enum": [
          "None",
          "Dairy",
          "Egg",
          "Fish",
          "Meat"
        ]
      },
      "ConsumeInput": {
        "required": [
          "outcome",
          "amount"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/ConsumeOutcome"
          },
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "ConsumeOutcome": {
        "enum": [
          "Used",
          "Discarded"
        ]
      },
      "DailyCheckResultDto": {
        "required": [
          "sent",
          "title",
          "body"
        ],
        "type": "object",
        "properties": {
          "sent": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DietType": {
        "enum": [
          "Omnivore",
          "Flexitarian",
          "Pescatarian",
          "Vegetarian",
          "Vegan"
        ]
      },
      "EndpointInput": {
        "required": [
          "endpoint"
        ],
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string"
          }
        }
      },
      "HealthDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Ingredient": {
        "required": [
          "key",
          "name",
          "aliases",
          "category",
          "allergens",
          "animal",
          "shelfLifeDays",
          "openedShelfLifeDays"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "allergens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "animal": {
            "$ref": "#/components/schemas/AnimalProduct"
          },
          "shelfLifeDays": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "openedShelfLifeDays": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "openedLocation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StorageLocation"
              }
            ]
          }
        }
      },
      "ItemDto": {
        "required": [
          "id",
          "name",
          "ingredientKey",
          "quantity",
          "unit",
          "location",
          "expiryDate",
          "openedDate",
          "effectiveExpiry",
          "daysLeft",
          "urgency",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "ingredientKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/StorageLocation"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "openedDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "effectiveExpiry": {
            "type": "string",
            "format": "date"
          },
          "daysLeft": {
            "type": "integer",
            "format": "int32"
          },
          "urgency": {
            "$ref": "#/components/schemas/Urgency"
          },
          "status": {
            "$ref": "#/components/schemas/ItemStatus"
          }
        }
      },
      "ItemInput": {
        "required": [
          "name",
          "ingredientKey",
          "quantity",
          "unit",
          "location",
          "expiryDate",
          "openedDate"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ingredientKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/StorageLocation"
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "openedDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "ItemStatus": {
        "enum": [
          "Active",
          "Used",
          "Discarded"
        ]
      },
      "Language": {
        "enum": [
          "English",
          "Norwegian",
          "Finnish",
          null
        ]
      },
      "PantryItem": {
        "required": [
          "id",
          "name",
          "ingredientKey",
          "daysLeft"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "ingredientKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "daysLeft": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductDto": {
        "required": [
          "name",
          "productName",
          "quantity",
          "unit"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "productName": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileDto": {
        "required": [
          "diet",
          "allergens",
          "notificationTime",
          "timeZone",
          "notificationsEnabled",
          "language"
        ],
        "type": "object",
        "properties": {
          "diet": {
            "$ref": "#/components/schemas/DietType"
          },
          "allergens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "notificationTime": {
            "type": "string",
            "format": "time"
          },
          "timeZone": {
            "type": "string"
          },
          "notificationsEnabled": {
            "type": "boolean"
          },
          "language": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Language"
              }
            ]
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "diet": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DietType"
              }
            ]
          },
          "allergens": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "notificationTime": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          },
          "notificationsEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "language": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Language"
              }
            ]
          }
        }
      },
      "PushKeys": {
        "required": [
          "p256dh",
          "auth"
        ],
        "type": "object",
        "properties": {
          "p256dh": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          }
        }
      },
